print("\nUnike organisasjonsnummer i 2025:")
print(data_2025['orgnr'].unique())

# Opprett en Excel-fil med begge datasettene i separate ark
with pd.ExcelWriter('datasett_2018_2025.xlsx', engine='openpyxl') as writer:
    data_2018.to_excel(writer, sheet_name='2018 data', index=False)
    data_2025.to_excel(writer, sheet_name='2025 data', index=False)

