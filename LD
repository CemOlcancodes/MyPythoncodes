# Tell antall unike organisasjonsnummer
antall_unique_orgnr_2018 = data_2018['orgnr'].nunique()
antall_unique_orgnr_2025 = data_2025['orgnr'].nunique()

print(f"Antall unike organisasjonsnummer i 2018: {antall_unique_orgnr_2018}")
print(f"Antall unike organisasjonsnummer i 2025: {antall_unique_orgnr_2025}")

# Vis de unike organisasjonsnumrene (valgfritt)
print("\nUnike organisasjonsnummer i 2018:")
