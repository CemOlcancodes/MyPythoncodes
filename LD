print(f"Innmarksbeite: {data_2018['innmarksbeite'].sum()}")

print("\n=== TOTALER FOR 2025 ===")
print(f"Total areal: {data_2025['totalareal'].sum()}")
print(f"Fulldyrket: {data_2025['fulldyrket'].sum()}")
print(f"Overflatedyrket: {data_2025['overflatedyrket'].sum()}")
print(f"Innmarksbeite: {data_2025['innmarksbeite'].sum()}")

print("\n=== ENDRING FRA 2018 TIL 2025 ===")
print(f"Total areal: {data_2025['totalareal'].sum() - data_2018['totalareal'].sum()}")
