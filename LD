import pandas as pd

# Last inn de to datasettene
data_2018 = pd.read_csv('2018data.csv', sep=';')
data_2025 = pd.read_csv('2025data.csv', sep=';')

# Konverter til heltall
data_2018['soeknads_aar'] = data_2018['soeknads_aar'].fillna(2018).astype(int)
data_2025['soeknads_aar'] = data_2025['soeknads_aar'].fillna(2025).astype(int)
data_2018['saksbehandlende_kommune'] = data_2018['saksbehandlende_kommune'].fillna(0).astype(int)
data_2025['saksbehandlende_kommune'] = data_2025['saksbehandlende_kommune'].fillna(0).astype(int)

# Filtrer 2018 data
kommuner_2018 = [211, 213, 214, 215, 216, 217, 219, 220, 221, 226, 227, 228, 229, 230, 231, 233, 234, 235, 236, 237, 238, 239, 299]
data_2018 = data_2018[data_2018['saksbehandlende_kommune'].isin(kommuner_2018)]

# Filtrer 2025 data
kommuner_2025 = [3201, 3203, 3205, 3207, 3209, 3212, 3214, 3216, 3218, 3220, 3222, 3224, 3226, 3228, 3230, 3232, 3234, 3236, 3238, 3240, 3242]
data_2025 = data_2025[data_2025['saksbehandlende_kommune'].isin(kommuner_2025)]

# Vis resultatet
print("2018 data (filtrert):")
print(data_2018.head())
print(f"Antall rader: {len(data_2018)}")

