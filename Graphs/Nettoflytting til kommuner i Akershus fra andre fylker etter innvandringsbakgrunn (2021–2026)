import matplotlib.pyplot as plt
import numpy as np

municipalities_orig = [
    "Bærum", "Asker", "Lillestrøm", "Nordre Follo", "Ullensaker", "Nesodden",
    "Frogn", "Vestby", "Ås", "Enebakk", "Lørenskog", "Rælingen",
    "Aurskog-Høland", "Nes", "Gjerdrum", "Nittedal", "Lunner", "Jevnaker",
    "Nannestad", "Eidsvoll", "Hurdal"
]

A_orig = [244, -92, 233, 816, -189, 263, -92, -59, 152, -247, 994, 27, -170, -321, -88, -43, -86, -127, -134, -114, -27]
B_orig = [1134, 694, 3448, 1121, 1640, 121, 54, 206, 232, 291, 3042, 577, 175, 281, 91, 638, -13, 19, 376, 657, 33]
C_orig = [181, 62, 1230, 379, 597, 20, 2, 67, 137, 106, 1263, 189, 43, 66, 9, 247, 0, 4, 133, 162, 0]

new_order = [0, 1, 3, 5, 6, 7, 8, 9, 2, 10, 11, 12, 15, 13, 14, 16, 17, 4, 18, 19, 20]

municipalities = [municipalities_orig[i] for i in new_order]
A = [A_orig[i] for i in new_order]
B = [B_orig[i] for i in new_order]
C = [C_orig[i] for i in new_order]

order = list(range(len(municipalities)))[::-1]
mun = [municipalities[i] for i in order]
Av  = [A[i] for i in order]
Bv  = [B[i] for i in order]
Cv  = [C[i] for i in order]

y = np.arange(len(mun))
h = 0.26

fig, ax = plt.subplots(figsize=(11, 13))

bars_a = ax.barh(y + h, Av, height=h, color="#1a3a6b", label="Født i Norge m/ norskfødte foreldre")
bars_b = ax.barh(y,     Bv, height=h, color="#f5a623", label="Innvandrere")
bars_c = ax.barh(y - h, Cv, height=h, color="#e07aaa", label="Norskfødte m/ innvandrerforeldre")

ax.set_yticks(y)
ax.set_yticklabels(mun, fontsize=10.5)
ax.tick_params(axis="y", length=0)
ax.axvline(0, color="black", linewidth=0.8)
ax.set_xlabel("Nettoflytting (personer)", fontsize=11)
ax.legend(loc="lower right", frameon=True, fontsize=9.5, framealpha=0.9)
ax.grid(axis="x", linestyle="-", linewidth=0.4, alpha=0.3)
ax.set_axisbelow(True)

for spine in ["top", "right", "left"]:
    ax.spines[spine].set_visible(False)

def label_bars(bars, values):
    for bar, val in zip(bars, values):
        x = bar.get_width()
        if val == 0:
            continue
        y_pos = bar.get_y() + bar.get_height() / 2
        offset = 5 if x >= 0 else -5
        ha = "left" if x >= 0 else "right"
        ax.annotate(f"+{val:,}".replace(",", " ") if val > 0 else f"{val:,}".replace(",", " "),
                    xy=(x, y_pos), xytext=(offset, 0),
                    textcoords="offset points",
                    va="center", ha=ha, fontsize=8, color="#333333")

label_bars(bars_a, Av)
label_bars(bars_b, Bv)
label_bars(bars_c, Cv)

all_vals = Av + Bv + Cv
ax.set_xlim(min(all_vals) - 100, max(all_vals) + 400)
ax.set_ylim(-0.8, len(mun) - 0.2)

plt.title("Nettoflytting til kommuner i Akershus fra resten av Norge (2021-2026)",
          fontsize=12, pad=14, fontweight="bold")
plt.tight_layout()
plt.savefig("netto_innflytting3.png", dpi=200, bbox_inches="tight")
